#!/bin/bash

set -euo pipefail

if (( $# == 0 )); then
  echo "Usage: omarchy-launch-edge-webapp <url> [browser-arguments...]" >&2
  exit 2
fi

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
url_key=$(printf '%s' "$1" | sha256sum | cut -d' ' -f1)
lock_file="$runtime_dir/omarchy-edge-webapp-$url_key.lock"

# Hyprland can emit both startup and workspace activation before Edge maps its
# window. Keep one launcher per URL alive briefly so the second event cannot
# start a duplicate app window.
exec 9>"$lock_file"
flock -n 9 || exit 0

setsid uwsm-app -- microsoft-edge-stable --app="$1" "${@:2}"
sleep 5
