#!/usr/bin/env bash

# Workspace startup and monitor settling can report workspace 6 as empty more
# than once. Serialize those reports so ao cannot initialize Zero twice.
set -u

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
lock_file=$runtime_dir/traap-launch-zero.lock

exec 9>"$lock_file"
flock -n 9 || exit 0

# A window may have appeared after Hyprland emitted the empty-workspace event.
if hyprctl workspaces -j \
  | jq -e 'any(.[]; .id == 6 and .windows > 0)' >/dev/null; then
  exit 0
fi

"${HOME}/git/dotfiles/bash/bin/toggler" Zero

# Ghostty may hand the new surface to its existing process and return before
# Hyprland publishes it. Keep the lock briefly so a second event cannot race.
sleep 2
