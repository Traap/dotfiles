#!/bin/bash
# {{{ Settings installed or updated by other programs.

[[ -f "$HOME/traap/.ghcup/env" ]] && source "$HOME/traap/.ghcup/env"

# sshkeys writes ~/.ssh/agent_env on Arch, WSL, and Git Bash.
[[ -f "$HOME/.ssh/agent_env" ]] && source "$HOME/.ssh/agent_env"

# One fzf initializer. `fzf --bash` covers keys and completion.
# Otherwise use the user file, then the distro files. Never more than one.
if command -v fzf >/dev/null 2>&1; then
  __fzf_bash="$(fzf --bash 2>/dev/null)" || __fzf_bash=""
else
  __fzf_bash=""
fi
if [[ -n $__fzf_bash ]]; then
  eval "$__fzf_bash"
elif [[ -f $HOME/.fzf.bash ]]; then
  source "$HOME/.fzf.bash"
else
  [[ -f /usr/share/fzf/completion.bash ]] && \
    source /usr/share/fzf/completion.bash
  [[ -f /usr/share/fzf/key-bindings.bash ]] && \
    source /usr/share/fzf/key-bindings.bash
fi
unset __fzf_bash

if [[ -f "$HOME/.config/lua-language-server/3rd/luamake/luamake" ]]; then
  alias luamake="$HOME/.config/lua-language-server/3rd/luamake/luamake"
fi

[[ -f "$HOME/lib/azure-cli/az.completion" ]] && \
  source "$HOME/lib/azure-cli/az.completion"

[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"

# Cache the generated completion. Regenerate when the uv binary changes.
if command -v uv >/dev/null 2>&1; then
  __uv_bin="$(command -v uv)"
  __uv_completion="${XDG_CACHE_HOME:-$HOME/.cache}/dotfiles/uv.bash"
  if [[ ! -s $__uv_completion || $__uv_completion -ot $__uv_bin ]]; then
    mkdir -p -- "${__uv_completion%/*}"
    if ! uv generate-shell-completion bash > "$__uv_completion"; then
      rm -f -- "$__uv_completion"
    fi
  fi
  [[ -s $__uv_completion ]] && source "$__uv_completion"
  unset __uv_bin __uv_completion
fi

# Shims avoid mise's per-prompt hook. A directory change does not
# switch tool versions until `mise activate` is run without --shims.
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash --shims)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

export PATH="$HOME/.grok/bin:$PATH"
[[ -r "$HOME/.grok/completions/bash/grok.bash" ]] && \
  source "$HOME/.grok/completions/bash/grok.bash"

# wt follows the current directory on every call. Under ~/gitea/..., it
# is the function Paperboy's shell-init defined. Anywhere else, including
# ~/gitea itself, it is Worktrunk's wrapper. The alias decides at the
# call, so `cd ~/gitea/Paperboy && wt list` sees the directory just
# entered. shell-init finds sdlc/bin through BASH_SOURCE, so that
# function stays the one the file defined. A missing shell-init falls
# through to Worktrunk.
#
# While `alias wt` is set, Bash rewrites a function named wt as it reads
# the definition. `wt()` would be stored as `__wt_dispatch` and the
# dispatcher would disappear. Parse those definitions with expansion off
# and the alias removed. ~/.bashrc does that around Worktrunk's init
# line, then calls __wt_arm. The prompt hook does it again so a later
# init line cannot keep the rewritten function.

__wt_under_gitea() {
  local work workphys dir phys
  work=${WORKHOME:-$HOME/gitea}
  [[ -d $work ]] || return 1
  work=${work%/}
  workphys=$(cd -- "$work" && pwd -P) || return 1
  workphys=${workphys%/}
  phys=$(pwd -P) || return 1
  for dir in "${PWD%/}" "${phys%/}"; do
    [[ $dir == "$work"/* || $dir == "$workphys"/* ]] && return 0
  done
  return 1
}

__wt_copy_function() {
  local src=$1 dest=$2 body
  declare -F "$src" >/dev/null || return 1
  body=$(declare -f "$src" | sed "1s/^${src} /${dest} /")
  [[ $body == "$dest "* ]] || return 1
  __wt_parse_wt eval "$body"
}

__wt_paperboy_init() {
  printf '%s\n' "${WORKHOME:-$HOME/gitea}/Paperboy/sdlc/bin/shell-init"
}

# Run a command while `wt() { ... }` still defines a function named wt.
__wt_parse_wt() {
  local restore had=0 status=0
  restore=$(shopt -p expand_aliases)
  shopt -u expand_aliases
  if alias wt >/dev/null 2>&1; then
    had=1
    unalias wt
  fi
  "$@" || status=$?
  eval "$restore"
  if [[ $had -eq 1 ]]; then
    alias wt='__wt_dispatch'
  fi
  return "$status"
}

# Keep Worktrunk's cd wrapper under a private name. The copy is safe:
# that function calls the binary with `command`, not BASH_SOURCE.
__wt_remember_worktrunk() {
  declare -F wt >/dev/null || return 1
  [[ $(declare -f wt) == *WORKTRUNK_DIRECTIVE_CD_FILE* ]] || return 1
  __wt_copy_function wt __worktrunk_wt
}

__wt_load_worktrunk() {
  declare -F __worktrunk_wt >/dev/null && return 0
  local bin generated
  bin=$(type -P wt 2>/dev/null) || return 1
  generated=$("$bin" config shell init bash 2>/dev/null) || return 1
  [[ -n $generated ]] || return 1
  __wt_parse_wt eval "$generated" || return 1
  __wt_copy_function wt __worktrunk_wt || return 1
}

__wt_use_worktrunk() {
  __wt_remember_worktrunk || true
  if declare -F __worktrunk_wt >/dev/null; then
    __worktrunk_wt "$@"
    return
  fi
  if declare -F wt >/dev/null && \
      [[ $(declare -f wt) == *WORKTRUNK_DIRECTIVE_CD_FILE* ]]; then
    \wt "$@"
    return
  fi
  command wt "$@"
}

__wt_use_paperboy() {
  local init
  init=$(__wt_paperboy_init)
  if [[ ! -f $init ]]; then
    __wt_use_worktrunk "$@"
    return
  fi
  __wt_remember_worktrunk || true
  if ! declare -F wt >/dev/null || \
      [[ $(declare -f wt) == *WORKTRUNK_DIRECTIVE_CD_FILE* ]]; then
    # shellcheck source=/dev/null
    __wt_parse_wt source "$init" || { __wt_use_worktrunk "$@"; return; }
  fi
  if ! declare -F wt >/dev/null; then
    __wt_use_worktrunk "$@"
    return
  fi
  \wt "$@"
}

__wt_dispatch() {
  if __wt_under_gitea; then
    __wt_use_paperboy "$@"
  else
    __wt_use_worktrunk "$@"
  fi
}
__wt_dispatch_src=$(declare -f __wt_dispatch)

__wt_arm() {
  if ! declare -F __wt_dispatch >/dev/null || \
      [[ $(declare -f __wt_dispatch) == *WORKTRUNK_DIRECTIVE_CD_FILE* ]]; then
    [[ -n ${__wt_dispatch_src:-} ]] && eval "$__wt_dispatch_src"
  fi
  __wt_remember_worktrunk || true
  alias wt='__wt_dispatch'
}

case ":${PROMPT_COMMAND:-}:" in
  *__wt_arm*) ;;
  *) PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND; }__wt_arm" ;;
esac
__wt_load_worktrunk || true
__wt_arm
