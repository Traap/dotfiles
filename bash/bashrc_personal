#!/bin/bash
# {{{ Stooges: Honoring Larry, Moe, and Curly ... Nyuk, nyuk, nyuk.
#
# Bash scripting cheatsheet => https://devhints.io/bash

# {{{ Interactive terminal setup.
#     Arch, WSL, and Git Bash all source this file. A non-interactive
#     login, such as ssh host command, keeps PATH and EDITOR and returns
#     before completions, program hooks, and the ssh agent.

if [[ $- == *i* ]]; then
  [[ -t 0 ]] && stty -ixon
  echo "$HOSTNAME running $OSTYPE"
fi

# -------------------------------------------------------------------------- }}}
# {{{ Unlimited history. -1 is the Bash 4.3+ spelling. An empty value
#     leaves the default 500-line list on Bash 5.3.

HISTSIZE=-1
HISTFILESIZE=-1

# -------------------------------------------------------------------------- }}}
# {{{ shopt

shopt -s autocd         # change to named directory
shopt -s cdspell        # autocorrects cd misspellings
shopt -s cmdhist        # save multi-line commands in history as single line
shopt -s dotglob        # dot file names are included in path expansion.
shopt -s histappend     # do not overwrite history
shopt -s expand_aliases # expand aliases

# -------------------------------------------------------------------------- }}}
# {{{ Customize my shell. Array order matters.
#     The first group sets PATH and EDITOR. The second group is interactive.

my_array=("environment" "functions" "exports" "aliases" "paths")
for m in "${my_array[@]}"; do
  [[ -f "$BASHHOME/my_$m" ]] && __guarded_source "$BASHHOME/my_$m"
done

[[ $- == *i* ]] || return

my_array=("completions" "programs")
for m in "${my_array[@]}"; do
  [[ -f "$BASHHOME/my_$m" ]] && __guarded_source "$BASHHOME/my_$m"
done

# Load my keys.
sshkeys

# -------------------------------------------------------------------------- }}}
# {{ Neovim appname aliases

[[ -f "$HOME/.config/nvims/nvim_appnames" ]] && \
  __guarded_source "$HOME/.config/nvims/nvim_appnames"

# -------------------------------------------------------------------------- }}}
# {{{ Share history after Starship has installed its prompt hook.

history_sync() { history -a; }

case ":${PROMPT_COMMAND:-}:" in
  *history_sync*) ;;
  *) PROMPT_COMMAND="history_sync${PROMPT_COMMAND:+;$PROMPT_COMMAND}" ;;
esac

# -------------------------------------------------------------------------- }}}
