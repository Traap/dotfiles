#!/usr/bin/env bash
# {{{ vpnFlush - stop a stuck vpnConnect session and clear its leftovers

set -euo pipefail

# -------------------------------------------------------------------------- }}}
# {{{ Runtime configuration
#
# vpnConnect stores the VPN password in a mode 600 temp file and runs
# snx-rs through sudo.  A killed session can leave that file, the snx-xfrm
# device, and kernel IPSec state behind.  snx-rs names its IPSec device
# snx-xfrm and keeps keepalive routes in table 18234.
#
# A tunnel can also look connected while it forwards nothing.  Mounts then
# fail until systemd hits its start limit and stops the automount.  That
# latch survives until reset-failed.  It does not require a reboot.

VPN_FLUSH_INTERFACE="${VPN_FLUSH_INTERFACE:-snx-xfrm}"
VPN_FLUSH_ROUTE_TABLE="${VPN_FLUSH_ROUTE_TABLE:-18234}"
VPN_FLUSH_WAIT_SECONDS="${VPN_FLUSH_WAIT_SECONDS:-5}"
VPN_FLUSH_TMPDIR="${TMPDIR:-/tmp}"

DRY_RUN=false
MODE=full
SUDO_READY=false
CHANGED=false
SELF_PID=$BASHPID
TARGET_PIDS=()
declare -A ALREADY_SIGNALED=()

# -------------------------------------------------------------------------- }}}
# {{{ Console output helpers

green()  { printf "\033[1;32m%s\033[0m\n" "$*"; }
yellow() { printf "\033[1;33m%s\033[0m\n" "$*"; }
red()    { printf "\033[1;31m%s\033[0m\n" "$*"; }

info()  { green  "[INFO]  $*"; }
warn()  { yellow "[WARN]  $*"; }
fail()  { red    "[FAIL]  $*"; }

notify_flushed() {
  local title="VPN flushed"
  local body="Cleared leftover VPN processes, files, and tunnel state."

  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send "$title" "$body" || \
      warn "Desktop notification failed."
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name="vpnFlush" "$title" "$body" || \
      warn "Desktop notification failed."
  fi
}

# -------------------------------------------------------------------------- }}}
# {{{ User documentation

print_help() {
  cat <<'HELP'
vpnFlush - stop a stuck vpnConnect session so a new one can start

Usage:
  vpnFlush
  vpnFlush --dry-run
  vpnFlush --kernel [--dry-run]
  vpnFlush --mounts [--dry-run]
  vpnFlush --help

Behavior:
  - Sends TERM to every vpnConnect process, then to snx-rs and the
    children of that session.  Processes still running after the wait
    are killed.  The vpn tmux session and "ao vpn" launcher are left
    running.
  - Stops a noninteractive "kinit -k".  That kinit has no password
    prompt, and during a flush it is waiting on a KDC the flush is
    about to disconnect.  An interactive kinit is left alone.
  - Gives snx-rs time to remove its own tunnel before a second pass.
  - Wipes vpnConnect.runtime.* and vpnConnect.snx-rs.* in the temp
    directory.  The runtime file holds the VPN password.
  - Deletes the snx-xfrm interface when it is still present.
  - Removes routing rules that select table 18234, then flushes that
    route table.  snx-rs uses this table for IPSec keepalive routes.
  - Flushes all kernel IPSec states and policies.  This host's only
    XFRM user is snx-rs.  Another IPSec tunnel would be removed too.
  - Flushes the systemd-resolved cache.  A dead tunnel leaves negative
    answers for AD names, and those answers outlive the tunnel.
  - Lazy-unmounts CIFS mounts under /mnt, kills mount.cifs left behind
    by a timed-out mount unit, installs the Kerberos mount retry policy
    when it is not already installed, clears the mount start-limit,
    and starts the automounts again.  None of this needs a reboot.
  - Removes an adConnect lock whose owner is no longer running.  A live
    adConnect, including the user service, is left alone.  Saved
    adConnect state is not touched.
  - Asks for sudo once.  Root is required to signal snx-rs and to
    change IPSec, routes, interfaces, and mount units.

  --kernel skips processes, runtime files, and mount changes.  vpnConnect
  uses it to drop a dead data plane before the next snx-rs start.

  --mounts only repairs CIFS automounts.  It does nothing when they are
  already armed and the retry policy is installed, so adConnect can call
  it on a timer.  A working share is not unmounted.

Options:
  --dry-run
      Print the actions without signaling processes, deleting files,
      or changing network state.  It can be combined with --kernel or
      --mounts.

  --kernel
      Remove the tunnel interface, keepalive routes, and IPSec state,
      then flush the DNS cache.  Do not stop vpnConnect or snx-rs.

  --mounts
      Repair latched CIFS automounts without stopping the VPN.

  -h, --help
      Show this help.

Environment:
  TMPDIR=/tmp
      Directory vpnConnect uses for its runtime config and log.

  VPN_FLUSH_INTERFACE=snx-xfrm
      Interface name snx-rs creates for the IPSec tunnel.

  VPN_FLUSH_ROUTE_TABLE=18234
      Routing table snx-rs uses for its IPSec keepalive route.

  VPN_FLUSH_WAIT_SECONDS=5
      How long to wait after each signal for snx-rs to exit and clean
      up.  The flush still runs if a process does not exit.

Exit status:
  0  The session was cleared, or there was nothing left to clear.
  1  A process, file, or kernel step could not be completed.
  2  The command line was not recognized.
HELP
}

# -------------------------------------------------------------------------- }}}
# {{{ Process selection
#
# Match the command itself, not a terminal or editor that happens to
# mention the name.  Descendants cover the log tail, the sudo refresh
# loop, and adConnect while vpnConnect is waiting on it.

argv0_is() {
  local pid=$1
  local want=$2
  local arg0=""

  [[ -r "/proc/${pid}/cmdline" ]] || return 1
  IFS= read -r -d '' arg0 < "/proc/${pid}/cmdline" || return 1
  [[ "$arg0" == "$want" || "$arg0" == */"$want" ]]
}

process_has_arg() {
  local pid=$1
  local want=$2
  local arg=""

  [[ -r "/proc/${pid}/cmdline" ]] || return 1
  while IFS= read -r -d '' arg || [[ -n "$arg" ]]; do
    if [[ "$arg" == "$want" || "$arg" == */"$want" ]]; then
      return 0
    fi
    arg=""
  done < "/proc/${pid}/cmdline"
  return 1
}

is_vpn_connect_process() {
  local pid=$1

  [[ "$pid" == "$SELF_PID" ]] && return 1
  process_has_arg "$pid" vpnFlush && return 1
  if argv0_is "$pid" vpnConnect; then
    return 0
  fi
  if argv0_is "$pid" bash || argv0_is "$pid" sh; then
    process_has_arg "$pid" vpnConnect
    return
  fi
  return 1
}

is_snx_process() {
  local pid=$1

  if argv0_is "$pid" snx-rs; then
    return 0
  fi
  if argv0_is "$pid" sudo && process_has_arg "$pid" snx-rs; then
    return 0
  fi
  return 1
}

describe_pid() {
  local pid=$1
  local text=""

  text="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  text="${text%" "}"
  if ((${#text} > 60)); then
    text="${text:0:57}..."
  fi
  if [[ -z "$text" ]]; then
    text="pid ${pid}"
  fi
  printf '%s' "$text"
}

collect_targets() {
  local -A parent_of=()
  local -A want=()
  local pid=""
  local ppid=""
  local changed=true
  local guard=0

  TARGET_PIDS=()
  while read -r pid ppid; do
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    parent_of["$pid"]=$ppid
  done < <(ps -eo pid=,ppid=)

  if ((${#parent_of[@]} == 0)); then
    return 0
  fi

  for pid in "${!parent_of[@]}"; do
    if is_vpn_connect_process "$pid" || is_snx_process "$pid"; then
      want["$pid"]=1
    fi
  done

  while $changed && (( guard < 30 )); do
    changed=false
    guard=$((guard + 1))
    for pid in "${!parent_of[@]}"; do
      [[ -n "${want[$pid]:-}" ]] && continue
      [[ "$pid" == "$SELF_PID" ]] && continue
      ppid="${parent_of[$pid]}"
      if [[ -n "${want[$ppid]:-}" ]]; then
        want["$pid"]=1
        changed=true
      fi
    done
  done

  if ((${#want[@]} == 0)); then
    return 0
  fi

  while read -r pid; do
    [[ -n "$pid" ]] || continue
    TARGET_PIDS+=("$pid")
  done < <(printf '%s\n' "${!want[@]}" | sort -n)
}

# -------------------------------------------------------------------------- }}}
# {{{ Stop the session

signal_pid() {
  local signal=$1
  local pid=$2

  [[ -d "/proc/${pid}" ]] || return 0
  if kill "-${signal}" "$pid" 2>/dev/null; then
    return 0
  fi
  if $SUDO_READY; then
    sudo -n kill "-${signal}" "$pid" 2>/dev/null || \
      warn "Could not send ${signal} to ${pid}."
    return 0
  fi
  warn "Could not send ${signal} to ${pid} without sudo."
}

targets_alive() {
  local pid

  if ((${#TARGET_PIDS[@]} == 0)); then
    return 1
  fi
  for pid in "${TARGET_PIDS[@]}"; do
    [[ -d "/proc/${pid}" ]] && return 0
  done
  return 1
}

wait_for_exit() {
  local deadline=$((SECONDS + VPN_FLUSH_WAIT_SECONDS))

  while (( SECONDS < deadline )); do
    targets_alive || return 0
    sleep 0.2
  done
  targets_alive && return 1
  return 0
}

signal_targets() {
  local signal=$1
  local only_role=${2:-}
  local pid role text
  local signaled=false

  if ((${#TARGET_PIDS[@]} == 0)); then
    return 1
  fi

  for pid in "${TARGET_PIDS[@]}"; do
    [[ -d "/proc/${pid}" ]] || continue
    if is_vpn_connect_process "$pid"; then
      role="vpnConnect"
    elif is_snx_process "$pid"; then
      role="snx-rs"
    else
      role="child"
    fi
    if [[ -n "$only_role" && "$role" != "$only_role" ]]; then
      continue
    fi
    if [[ -n "${ALREADY_SIGNALED[${signal}:${pid}]:-}" ]]; then
      continue
    fi
    text="$(describe_pid "$pid")"
    if $DRY_RUN; then
      info "Would send ${signal} to ${pid} (${text})."
    else
      info "Sending ${signal} to ${pid} (${text})."
      signal_pid "$signal" "$pid"
      CHANGED=true
    fi
    ALREADY_SIGNALED["${signal}:${pid}"]=1
    signaled=true
  done

  $signaled
}

stop_processes() {
  collect_targets

  if ((${#TARGET_PIDS[@]} == 0)); then
    info "No vpnConnect or snx-rs processes are running."
    return 0
  fi

  # TERM the shell first so its own cleanup can stop snx-rs.
  if signal_targets TERM vpnConnect; then
    if ! $DRY_RUN; then
      wait_for_exit || true
    fi
  fi

  if signal_targets TERM; then
    if ! $DRY_RUN; then
      wait_for_exit || true
    fi
  fi

  if $DRY_RUN; then
    if ((${#TARGET_PIDS[@]} > 0)); then
      info "Would send KILL to any VPN process still running after the wait."
    fi
    return 0
  fi

  if targets_alive; then
    warn "Some VPN processes are still running; sending KILL."
    signal_targets KILL || true
    wait_for_exit || \
      warn "A VPN process is still present. It may be blocked in the kernel."
  fi
}

# -------------------------------------------------------------------------- }}}
# {{{ Runtime files and adConnect lock

wipe_file() {
  local file=$1

  [[ -f "$file" && ! -L "$file" ]] || return 0
  if $DRY_RUN; then
    info "Would wipe ${file}."
    return 0
  fi

  info "Wiping ${file}."
  if command -v shred >/dev/null 2>&1 && shred -u -- "$file"; then
    CHANGED=true
    return 0
  fi
  warn "Could not shred ${file}; truncating it instead."
  : >"$file" || true
  rm -f -- "$file"
  CHANGED=true
}

wipe_runtime_files() {
  local found=false
  local file=""

  if [[ ! -d "$VPN_FLUSH_TMPDIR" ]]; then
    warn "Temp directory is missing: ${VPN_FLUSH_TMPDIR}."
    return 0
  fi

  while IFS= read -r -d '' file; do
    found=true
    wipe_file "$file"
  done < <(find "$VPN_FLUSH_TMPDIR" -maxdepth 1 -type f \
    \( -name 'vpnConnect.runtime.*' -o -name 'vpnConnect.snx-rs.*' \) \
    -print0)

  if ! $found; then
    info "No vpnConnect runtime files in ${VPN_FLUSH_TMPDIR}."
  fi
}

clear_stale_ad_lock() {
  local lock="${XDG_RUNTIME_DIR:-/tmp}/adConnect.${UID}.lock"
  local owner="${lock}/owner"
  local key=""
  local value=""
  local pid=""

  [[ -d "$lock" ]] || return 0

  if [[ -r "$owner" ]]; then
    while IFS='=' read -r key value; do
      if [[ "$key" == "pid" ]]; then
        pid=$value
      fi
    done < "$owner"
  fi

  if [[ "$pid" =~ ^[0-9]+$ && -d "/proc/${pid}" ]]; then
    info "Leaving live adConnect lock owned by ${pid}."
    return 0
  fi

  if $DRY_RUN; then
    info "Would remove stale adConnect lock ${lock}."
    return 0
  fi

  rm -f -- "$owner"
  if rmdir -- "$lock" 2>/dev/null; then
    info "Removed stale adConnect lock."
    CHANGED=true
  else
    warn "Could not remove adConnect lock ${lock}."
    return 1
  fi
}

# -------------------------------------------------------------------------- }}}
# {{{ Kernel tunnel state

run_root() {
  if $DRY_RUN; then
    info "Would run: sudo -n $*"
    return 0
  fi
  if ! $SUDO_READY; then
    fail "Skipping, sudo is not available: $*"
    return 1
  fi
  if ! sudo -n "$@"; then
    fail "Command failed: sudo -n $*"
    return 1
  fi
}

flush_route_rules() {
  local -a prefs=()
  local pref=""

  while read -r pref; do
    [[ "$pref" =~ ^[0-9]+$ ]] || continue
    prefs+=("$pref")
  done < <(ip rule show 2>/dev/null | awk -v table="$VPN_FLUSH_ROUTE_TABLE" '
    {
      lookup = "lookup " table
      if ($0 ~ lookup "$" || $0 ~ lookup " ") {
        split($1, pref, ":")
        print pref[1]
      }
    }
  ')

  if ((${#prefs[@]} == 0)); then
    info "No routing rules select table ${VPN_FLUSH_ROUTE_TABLE}."
    return 0
  fi

  for pref in "${prefs[@]}"; do
    if $DRY_RUN; then
      info "Would delete routing rule preference ${pref}."
      continue
    fi
    info "Deleting routing rule preference ${pref}."
    run_root ip rule del pref "$pref" || return 1
  done
}

flush_kernel() {
  local failed=false

  if ip link show dev "$VPN_FLUSH_INTERFACE" >/dev/null 2>&1; then
    if $DRY_RUN; then
      info "Would delete interface ${VPN_FLUSH_INTERFACE}."
    else
      info "Deleting interface ${VPN_FLUSH_INTERFACE}."
      run_root ip link del dev "$VPN_FLUSH_INTERFACE" || failed=true
      CHANGED=true
    fi
    if command -v resolvectl >/dev/null 2>&1; then
      if $DRY_RUN; then
        info "Would run: sudo -n resolvectl revert ${VPN_FLUSH_INTERFACE}"
      else
        sudo -n resolvectl revert "$VPN_FLUSH_INTERFACE" >/dev/null 2>&1 || true
      fi
    fi
  else
    info "No ${VPN_FLUSH_INTERFACE} interface."
  fi

  flush_route_rules || failed=true
  info "Flushing route table ${VPN_FLUSH_ROUTE_TABLE}."
  run_root ip route flush table "$VPN_FLUSH_ROUTE_TABLE" || failed=true
  info "Flushing kernel IPSec state and policy."
  run_root ip xfrm state flush || failed=true
  run_root ip xfrm policy flush || failed=true

  if $failed; then
    return 1
  fi
}

# -------------------------------------------------------------------------- }}}
# {{{ Entry point

ensure_sudo() {
  if $DRY_RUN; then
    SUDO_READY=true
    return 0
  fi
  # vpnConnect and the adConnect timer set VPN_FLUSH_NONINTERACTIVE so a
  # password prompt cannot stall them.  An interactive adConnect may ask.
  if [[ "$MODE" == full || \
        ( -r /dev/tty && "${VPN_FLUSH_NONINTERACTIVE:-}" != true ) ]]; then
    if sudo -v; then
      SUDO_READY=true
      return 0
    fi
    SUDO_READY=false
    if [[ "$MODE" == full ]]; then
      warn "sudo was not granted. Runtime files will still be wiped."
    else
      warn "sudo was not granted for vpnFlush --${MODE}."
    fi
    return 1
  fi
  if sudo -n -v >/dev/null 2>&1; then
    SUDO_READY=true
    return 0
  fi
  SUDO_READY=false
  warn "sudo is not available for vpnFlush --${MODE}."
  return 1
}

parse_args() {
  local arg

  while (($#)); do
    arg=$1
    shift
    case "$arg" in
      --dry-run)
        DRY_RUN=true
        ;;
      --kernel)
        MODE=kernel
        ;;
      --mounts)
        MODE=mounts
        ;;
      -h|--help)
        print_help
        exit 0
        ;;
      *)
        fail "Unknown argument: $arg" >&2
        print_help >&2
        exit 2
        ;;
    esac
  done

}

# -------------------------------------------------------------------------- }}}
# {{{ CIFS automount recovery
#
# systemd stops an automount after a burst of failures and leaves it
# inactive.  reset-failed plus start is enough.  The retry policy keeps
# the next burst from latching the unit again.  A reboot is not part of
# this recovery.

mount_retry_source() {
  local root

  root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
  printf '%s\n' "$root/systemd/system/mnt-.mount.d/kerberos-retry.conf"
}

list_mount_units() {
  local kind=$1

  systemctl list-units --all --no-legend --plain \
    "mnt-*.${kind}" 2>/dev/null | awk '{print $1}'
}

mount_retry_installed() {
  local src dest

  src="$(mount_retry_source)"
  dest=/etc/systemd/system/mnt-.mount.d/kerberos-retry.conf
  [[ -f "$src" && -f "$dest" ]] && cmp -s "$src" "$dest"
}

cifs_mounts_need_rearm() {
  if ! list_mount_units automount | grep -q .; then
    return 1
  fi
  if ! mount_retry_installed; then
    return 0
  fi
  if systemctl list-units --failed --no-legend --plain \
      'mnt-*.mount' 'mnt-*.automount' 2>/dev/null | grep -q .; then
    return 0
  fi
  while read -r unit; do
    [[ -n "$unit" ]] || continue
    if [[ "$(systemctl is-active "$unit" 2>/dev/null || true)" != active ]]; then
      return 0
    fi
  done < <(list_mount_units automount)
  return 1
}

install_mount_retry() {
  local src dest

  src="$(mount_retry_source)"
  dest=/etc/systemd/system/mnt-.mount.d/kerberos-retry.conf
  if [[ ! -f "$src" ]]; then
    warn "Mount retry policy is missing: ${src}."
    return 0
  fi
  if mount_retry_installed; then
    return 0
  fi
  if $DRY_RUN; then
    info "Would install ${dest} and reload systemd."
    return 0
  fi
  info "Installing CIFS mount retry policy."
  run_root install -D -m 644 "$src" "$dest" || return 1
  run_root systemctl daemon-reload || return 1
  CHANGED=true
}

flush_resolver_cache() {
  if ! command -v resolvectl >/dev/null 2>&1; then
    return 0
  fi
  if $DRY_RUN; then
    info "Would flush the systemd-resolved cache."
    return 0
  fi
  info "Flushing the systemd-resolved cache."
  run_root resolvectl flush-caches >/dev/null || return 1
  CHANGED=true
}

kill_pid() {
  local pid=$1

  if $DRY_RUN; then
    info "Would stop ${pid} ($(describe_pid "$pid"))."
    return 0
  fi
  info "Stopping ${pid} ($(describe_pid "$pid"))."
  signal_pid TERM "$pid"
  CHANGED=true
}

release_one_mount() {
  local target=$1
  local force_all=$2
  local unit state

  [[ "$target" == /mnt/* ]] || return 0
  unit="$(systemd-escape -p --suffix=mount "$target" 2>/dev/null || true)"
  state=""
  if [[ -n "$unit" ]]; then
    state="$(systemctl is-active "$unit" 2>/dev/null || true)"
  fi
  if [[ "$force_all" != true && "$state" == active ]]; then
    return 0
  fi
  if $DRY_RUN; then
    info "Would lazy-unmount ${target}."
    return 0
  fi
  info "Lazy-unmounting ${target}."
  run_root umount -l "$target" || warn "Could not unmount ${target}."
  CHANGED=true
}

mount_helper_is_stuck() {
  local pid=$1
  local text target fstype

  text="$(tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null || true)"
  for target in $text; do
    [[ "$target" == /mnt/* ]] || continue
    fstype="$(findmnt -n -o FSTYPE -T "$target" 2>/dev/null || true)"
    [[ "$fstype" == cifs ]] && return 1
    return 0
  done
  return 0
}

release_cifs_mounts() {
  local force_all=$1
  local target pid

  while read -r target; do
    [[ -n "$target" ]] || continue
    release_one_mount "$target" "$force_all"
  done < <(findmnt -n -t cifs -o TARGET 2>/dev/null || true)

  for pid in /proc/[0-9]*; do
    pid="${pid##*/}"
    [[ "$pid" == "$SELF_PID" ]] && continue
    if ! argv0_is "$pid" mount.cifs && ! argv0_is "$pid" mount.smb3; then
      continue
    fi
    if [[ "$force_all" != true ]] && ! mount_helper_is_stuck "$pid"; then
      continue
    fi
    kill_pid "$pid"
  done
}

rearm_cifs_automounts() {
  local -a units=()
  local unit

  while read -r unit; do
    [[ -n "$unit" ]] || continue
    units+=("$unit")
  done < <(list_mount_units automount)

  if ((${#units[@]} == 0)); then
    info "No CIFS automount units are loaded."
    return 0
  fi

  if $DRY_RUN; then
    info "Would reset failed mount state and start: ${units[*]}."
    return 0
  fi

  info "Clearing failed CIFS mount state."
  local -a mount_units=()
  while read -r unit; do
    [[ -n "$unit" ]] || continue
    mount_units+=("$unit")
  done < <(list_mount_units mount)
  run_root systemctl reset-failed "${units[@]}" "${mount_units[@]}" || \
    return 1
  info "Starting CIFS automounts."
  run_root systemctl start "${units[@]}" || return 1
  CHANGED=true
}

recover_mounts() {
  local force_all=$1

  if [[ "$force_all" != true ]] && ! cifs_mounts_need_rearm; then
    return 0
  fi

  install_mount_retry || return 1
  release_cifs_mounts "$force_all" || return 1
  rearm_cifs_automounts || return 1
  flush_resolver_cache || return 1
}

stop_noninteractive_kinit() {
  local pid

  for pid in /proc/[0-9]*; do
    pid="${pid##*/}"
    [[ "$pid" == "$SELF_PID" ]] && continue
    argv0_is "$pid" kinit || continue
    process_has_arg "$pid" -k || continue
    kill_pid "$pid"
  done
}

# -------------------------------------------------------------------------- }}}
# {{{ Entry point continued

main() {
  local status=0

  parse_args "$@"

  case "$MODE" in
    kernel)
      if ! ensure_sudo; then
        status=1
      else
        flush_kernel || status=1
        flush_resolver_cache || status=1
      fi
      ;;
    mounts)
      # Stay quiet when the automounts are already armed.  adConnect's
      # timer calls this mode and must not prompt for sudo every time.
      if ! cifs_mounts_need_rearm; then
        exit 0
      fi
      if ! ensure_sudo; then
        status=1
      else
        recover_mounts false || status=1
      fi
      ;;
    full)
      ensure_sudo || status=1
      stop_processes
      stop_noninteractive_kinit
      wipe_runtime_files
      clear_stale_ad_lock || status=1
      if $SUDO_READY; then
        flush_kernel || status=1
        recover_mounts true || status=1
      fi
      ;;
  esac

  if (( status == 0 )); then
    if [[ "$MODE" == mounts ]]; then
      :
    else
      info "VPN session cleared."
    fi
  else
    fail "VPN flush did not finish cleanly."
  fi

  if ! $DRY_RUN && $CHANGED && (( status == 0 )) && [[ "$MODE" == full ]]; then
    notify_flushed || true
  fi

  exit "$status"
}

main "$@"

# -------------------------------------------------------------------------- }}}
