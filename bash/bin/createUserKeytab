#!/usr/bin/env bash
# {{{ createUserKeytab — Provision a protected AD user keytab

set -euo pipefail

AD_USER="${AD_USER:?AD_USER not set}"
AD_DOMAIN="${AD_DOMAIN:?AD_DOMAIN not set}"
AD_REALM="${AD_DOMAIN^^}"
KEYTAB_DIR="${AD_CONNECT_KEYTAB_DIR:-$HOME/.config/krb5}"
KEYTAB_FILE="${AD_CONNECT_KEYTAB:-$KEYTAB_DIR/user.keytab}"
ENCTYPE="${AD_CONNECT_KEYTAB_ENCTYPE:-aes256-cts-hmac-sha1-96}"
SALT="${AD_CONNECT_KEYTAB_SALT:-}"
TEMP_KEYTAB="$KEYTAB_FILE.$$"
TEMP_CACHE="$KEYTAB_DIR/validate-cache.$$"

cleanup() {
    rm -f "$TEMP_KEYTAB" "$TEMP_CACHE"
}
trap cleanup EXIT

if [[ ! -t 0 || ! -t 1 ]]; then
    printf 'createUserKeytab must run from an interactive terminal.\n' >&2
    exit 1
fi

install -d -m 700 "$KEYTAB_DIR"

if [[ -z "$SALT" ]]; then
    trace="$(
        KRB5_TRACE=/dev/stderr timeout 10 \
            kinit "$AD_USER@$AD_REALM" </dev/null 2>&1 || true
    )"
    SALT="$(
        sed -n 's/.*Selected etype info:.*salt "\([^"]*\)".*/\1/p' \
            <<< "$trace" |
            head -n 1
    )"
    unset trace
fi

if [[ -z "$SALT" ]]; then
    printf 'Unable to obtain the password salt from the AD KDC.\n' >&2
    exit 1
fi

printf 'Create a keytab for %s@%s.\n' "$AD_USER" "$AD_REALM"
printf 'AD password: '
IFS= read -r -s password
printf '\n'

umask 077
printf 'addent -password -p %s@%s -k 0 -e %s -s %s\n%s\nwkt %s\nquit\n' \
    "$AD_USER" "$AD_REALM" "$ENCTYPE" "$SALT" "$password" "$TEMP_KEYTAB" |
    ktutil >/dev/null
unset password

if ! KRB5CCNAME="FILE:$TEMP_CACHE" \
    kinit -V -k -t "$TEMP_KEYTAB" "$AD_USER@$AD_REALM"; then
    printf 'Keytab validation failed; no keytab was installed.\n' >&2
    exit 1
fi

chmod 600 "$TEMP_KEYTAB"
mv "$TEMP_KEYTAB" "$KEYTAB_FILE"
printf 'Installed and validated %s.\n' "$KEYTAB_FILE"

# -------------------------------------------------------------------------- }}}
